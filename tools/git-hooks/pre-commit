#!/bin/sh
# ==============================================================================
# Pre-commit Hook para Proyectos de Unity y Videojuegos
# 1. Bloquea commits que incluyan assets en Assets/ sin su archivo .meta.
# 2. Bloquea commits con archivos mayores a 100 MB que no estén en Git LFS.
# ==============================================================================

ERRORS=0

# 1. Comprobar archivos .meta faltantes
for file in $(git diff --cached --name-only --diff-filter=A | grep '^Assets/'); do
    # Si el archivo no es un .meta en sí mismo
    if [ "${file##*.}" != "meta" ]; then
        if [ ! -f "${file}.meta" ] && ! git diff --cached --name-only | grep -qx "${file}.meta"; then
            echo "❌ [PRE-COMMIT ERROR] El asset '$file' no tiene su archivo .meta en staging."
            ERRORS=1
        fi
    fi
done

# 2. Comprobar archivos > 100 MB
MAX_BYTES=104857600
for file in $(git diff --cached --name-only --diff-filter=AM); do
    if [ -f "$file" ]; then
        # Verificar tamaño físico
        SIZE=$(wc -c < "$file" 2>/dev/null || stat -f%z "$file" 2>/dev/null || echo 0)
        if [ "$SIZE" -gt "$MAX_BYTES" ]; then
            # Comprobar si el archivo está rastreado por LFS
            if ! git check-attr filter "$file" | grep -q "filter: lfs"; then
                echo "🚨 [PRE-COMMIT ERROR] '$file' supera los 100 MB ($((SIZE / 1048576)) MB) y NO está en Git LFS."
                echo "   Ejecuta: git lfs track '$file' y añade el .gitattributes antes de commitear."
                ERRORS=1
            fi
        fi
    fi
done

if [ $ERRORS -ne 0 ]; then
    echo ""
    echo "⛔ Commit cancelado para proteger la integridad del repositorio y el límite de GitHub."
    exit 1
fi

exit 0
